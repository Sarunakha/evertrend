# API base URL (no trailing slash). Leave empty in dev to use Vite proxy (/api).
# Vite requires the VITE_ prefix (not REACT_APP_).
VITE_API_URL=https://evertrend-backend-git-development-sarunakhas-projects.vercel.app

# Google Sign-In (set in Vercel frontend env to remove login warning)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Dev-only: Vite proxy target when VITE_API_URL is unset
# VITE_BACKEND_URL=http://127.0.0.1:5001

# Google Sign-In (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Legacy CRA name (not read by Vite — use VITE_API_URL above)
# REACT_APP_API_URL=https://your-backend.vercel.app
