# Server
NODE_ENV=production
PORT=5001

# MongoDB (use MONGODB_URI; MONGO_URI is also supported)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/evertrend

# Auth
JWT_SECRET=your-super-secret-jwt-key

# Frontend (CORS, email links, Socket.io origin) — REQUIRED on Vercel backend
FRONTEND_URL=https://evertrend-frontend.vercel.app

# Optional: extra allowed origins (comma-separated)
# FRONTEND_URLS=https://evertrend-frontend.vercel.app,https://evertrend-frontend-git-development.vercel.app

# Email (Gmail App Password recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=EverTrend

# eSewa payment
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your-esewa-secret-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vercel sets VERCEL=1 automatically — do not set manually
#
# IMPORTANT for development branch deploys:
# In Vercel → Settings → Environment Variables, enable each variable for:
#   ☑ Production  ☑ Preview  ☑ Development
# Preview = deployments from non-main branches (e.g. "development")
